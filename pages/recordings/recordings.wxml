<view class="container {{themeClass}}">
  <view class="header card">
    <view class="row between">
      <view>
        <view class="title">我的录音 🎧</view>
        <view class="muted">回听练习轨迹，对比进步</view>
      </view>
      <view class="count">共 {{list.length}} 条</view>
    </view>
  </view>

  <!-- 同一句练了多次：拿最早和最新两条对比，分数与语速一起看 -->
  <view class="progress card" wx:if="{{groups.length}}">
    <view class="title">进步对比</view>
    <view class="muted">同一句练得越多，越能看出变化</view>
    <view class="group" wx:for="{{groups}}" wx:key="itemId">
      <view class="group-head">
        <view class="group-label">{{item.label}}</view>
        <view class="group-count">练了 {{item.count}} 次</view>
      </view>
      <view class="group-cn" wx:if="{{item.cn}}">{{item.cn}}</view>
      <view class="group-row">
        <view class="group-col">
          <view class="group-tag">最早</view>
          <view class="group-score" wx:if="{{item.bothScored}}">{{item.firstScore}} 分</view>
          <view class="group-sec" wx:if="{{item.firstSec}}">{{item.firstSec}}s</view>
          <view class="group-time">{{item.firstTime}}</view>
        </view>
        <view class="group-arrow">→</view>
        <view class="group-col">
          <view class="group-tag">最新</view>
          <view class="group-score {{item.up ? 'up' : ''}}" wx:if="{{item.bothScored}}">{{item.lastScore}} 分 <text class="delta" wx:if="{{item.deltaText}}">({{item.deltaText}})</text></view>
          <view class="group-sec" wx:if="{{item.lastSec}}">{{item.lastSec}}s</view>
          <view class="group-time">{{item.lastTime}}</view>
        </view>
        <view class="group-play {{compareId===item.itemId?'playing':''}}" data-item="{{item.itemId}}" bindtap="compareGroup">
          {{compareId===item.itemId?'⏸ 播放中':'🔁 前后对比'}}
        </view>
      </view>
    </view>
  </view>

  <block wx:if="{{list.length}}">
    <view class="rec-item card" wx:for="{{list}}" wx:key="id">
      <view class="rec-top">
        <view class="rec-label">{{item.label}}</view>
        <view class="score-badge" wx:if="{{item.score}}">{{item.score}}分</view>
      </view>
      <view class="rec-cn" wx:if="{{item.cn}}">{{item.cn}}</view>
      <view class="rec-recognized" wx:if="{{item.recognized}}">识别：{{item.recognized}}</view>
      <view class="rec-bottom">
        <view class="rec-time">{{item.timeText}} · {{item.kind==='dialogue'?'对话':(item.kind==='sentence'?'句子':'单词')}}</view>
        <view class="rec-actions">
          <view class="btn-play {{playingId===item.id?'playing':''}}" bindtap="play" data-id="{{item.id}}">{{playingId===item.id?'⏸ 停止':'▶️ 播放'}}</view>
          <view class="btn-del" bindtap="remove" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>
    <view class="clear-btn" bindtap="clearAll">清空全部录音</view>
  </block>

  <view class="empty card" wx:else>
    <view class="empty-icon">🎙️</view>
    <view class="title">还没有录音</view>
    <view class="muted">去口语练习页录音后，会自动保存在这里</view>
  </view>
</view>
