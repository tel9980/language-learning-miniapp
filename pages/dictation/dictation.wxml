<view class="container {{themeClass}}">
  <block wx:if="{{!finished && current}}">
    <view class="mode-tabs">
      <view class="mode-tab {{mode==='word'?'active':''}}" data-mode="word" bindtap="switchMode">单词听写</view>
      <view class="mode-tab {{mode==='sent'?'active':''}}" data-mode="sent" bindtap="switchMode">句子听写</view>
      <view class="mode-tab {{mode==='dlg'?'active':''}}" data-mode="dlg" bindtap="switchMode">对话听写</view>
    </view>

    <view class="card">
      <view class="row between">
        <view class="title">听写练习</view>
        <view class="muted">{{index+1}} / {{total}}</view>
      </view>
      <view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"></view></view>
      <view class="muted hint">听发音，把听到的内容写下来。标点和大小写不计较。</view>
      <view class="muted dlg-meta" wx:if="{{mode==='dlg'}}">{{current.scene}}<text wx:if="{{current.role}}"> · {{current.role}}</text></view>

      <view class="play-row">
        <view class="play-btn {{playing?'playing':''}}" bindtap="play">{{playing?'🔊 播放中':'🔊 播放'}}</view>
        <view class="muted">听不清可以多点几次</view>
      </view>

      <textarea class="write-box" value="{{input}}" bindinput="onInput" disabled="{{revealed}}"
                placeholder="{{mode==='word'?'写下这个单词':'写下这整句'}}" maxlength="200" auto-height />

      <view class="feedback {{isRight?'fb-right':'fb-wrong'}}" wx:if="{{revealed}}">
        <view class="fb-title">{{isRight?'✅ 写对了':'❌ 差一点'}}</view>
        <view class="fb-answer">正确答案：{{current.word}}</view>
        <view class="fb-example" wx:if="{{current.meaning}}">{{current.meaning}}</view>
      </view>

      <view class="btn-row">
        <button class="btn-ghost" wx:if="{{!revealed}}" bindtap="showAnswer">看答案</button>
        <button class="btn-primary" wx:if="{{!revealed}}" bindtap="submit">提交</button>
        <button class="btn-primary" wx:if="{{revealed}}" bindtap="next">{{index===total-1?'查看结果':'下一题 ›'}}</button>
      </view>
    </view>
  </block>

  <!-- 空状态（第十轮）：同测验，队列为空时整页纯白 -->
  <view class="card empty-box" wx:if="{{!finished && !current}}">
    <view class="empty-emoji">📭</view>
    <view class="empty-title">暂时没有可听写的内容</view>
    <view class="empty-tip">换一个模式试试，或者先去学几个新词再来听写。</view>
    <button class="btn-primary empty-btn" bindtap="restart">换一组</button>
    <button class="btn-ghost empty-btn" bindtap="goLearn">去学新词</button>
  </view>

  <view class="card result" wx:if="{{finished}}">
    <view class="result-emoji">{{accuracy>=80?'🎉':(accuracy>=60?'👍':'💪')}}</view>
    <view class="result-title">听写完成</view>
    <view class="result-accuracy">{{accuracy}}%</view>
    <view class="result-sub">正确率</view>
    <view class="result-detail">写对 {{correctCount}} 题 · 共 {{total}} 题</view>
    <view class="result-detail">写错的已经按「忘了」记进复习计划，明天会更早出现</view>
    <button class="btn-primary result-btn" bindtap="restart">再来一轮</button>
    <button class="btn-ghost result-btn" bindtap="goLearn">去学新词</button>
  </view>
</view>
