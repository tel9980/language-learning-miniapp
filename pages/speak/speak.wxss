.header { margin-bottom: 24rpx; }
.header .subtitle { margin-top: 8rpx; }
.today-badge { background: #EEF2FF; color: #4A6CF7; font-size: 24rpx; padding: 12rpx 20rpx; border-radius: 999rpx; white-space: nowrap; }
.row.between { display: flex; justify-content: space-between; align-items: center; }

/* 跟读类型切换 */
.track-tabs { display: flex; gap: 12rpx; margin-top: 28rpx; background: #F4F6FC; padding: 8rpx; border-radius: 16rpx; }
.tab { flex: 1; text-align: center; font-size: 26rpx; padding: 16rpx 0; border-radius: 12rpx; color: #8A94A6; }
.tab.on { background: #fff; color: #4A6CF7; font-weight: 600; box-shadow: 0 2rpx 10rpx rgba(74,108,247,.12); }
.scene-picker { margin-top: 20rpx; padding: 20rpx 24rpx; background: #F7F9FE; border-radius: 14rpx; font-size: 28rpx; color: #4A6CF7; }

.focus-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 24rpx; background: #FFF7EC; border-radius: 16rpx; }
.focus-bar.returning { background: #EEF2FF; }
.focus-info { flex: 1; }
.focus-title { font-size: 28rpx; font-weight: 600; color: #E08A1E; margin-bottom: 6rpx; }
.focus-bar.returning .focus-title { color: #4A6CF7; }
.arrow { font-size: 44rpx; color: #C7CEDB; margin-left: 8rpx; }
.record-entry { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 20rpx 24rpx; background: #F0FBF6; border-radius: 14rpx; font-size: 26rpx; color: #17A873; }

/* 跟读舞台 */
.stage { text-align: center; }
.progress-dots { display: flex; justify-content: center; flex-wrap: wrap; gap: 10rpx; margin-bottom: 40rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #E4E8F2; }
.progress-bar-row { display: flex; align-items: center; gap: 18rpx; margin-bottom: 40rpx; }
.progress-bar { flex: 1; height: 12rpx; border-radius: 999rpx; background: #E4E8F2; overflow: hidden; }
.progress-bar-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #6E8BFF, #4A6CF7); transition: width .25s ease; }
.progress-text { font-size: 24rpx; color: #8A94A6; min-width: 90rpx; text-align: right; }

.dot.on { background: #4A6CF7; width: 36rpx; border-radius: 999rpx; }
.dot.done { background: #A9BCFF; }
.role-tag { display: inline-block; font-size: 22rpx; color: #E08A1E; background: #FFF7EC; padding: 6rpx 18rpx; border-radius: 999rpx; margin-bottom: 16rpx; }
.stage-word { font-size: 64rpx; font-weight: 800; color: #4A6CF7; line-height: 1.3; }
.stage-word.sentence { font-size: 36rpx; line-height: 1.5; font-weight: 700; }
.stage-phonetic { font-size: 28rpx; color: #8A94A6; margin-top: 12rpx; }
.stage-meaning { font-size: 30rpx; margin-top: 16rpx; }
/* 弱网下载中：给用户一个「在等」的信号，否则点完发音毫无反应最容易被当成坏了 */
.stage-loading { font-size: 24rpx; color: #8A94A6; margin-top: 16rpx; }
.scene-tag { display: inline-block; font-size: 22rpx; color: #8A94A6; margin-top: 12rpx; }
.player-btns { display: flex; gap: 20rpx; margin: 36rpx 0 24rpx; }
.play-btn { flex: 1; font-size: 28rpx; border-radius: 999rpx; background: #EEF2FF; color: #4A6CF7; padding: 12rpx 0; }
.play-btn.primary { background: #4A6CF7; color: #fff; }
.play-btn::after { border: none; }
.example-box { background: #F7F9FE; border-radius: 20rpx; padding: 32rpx; text-align: left; }
.example-title { font-size: 22rpx; color: #8A94A6; margin-bottom: 16rpx; }
.example-en { font-size: 30rpx; line-height: 1.5; }
.example-cn { font-size: 24rpx; color: #8A94A6; margin-top: 12rpx; line-height: 1.5; }
.play-example { margin-top: 24rpx; font-size: 26rpx; color: #4A6CF7; background: none; padding: 0; }
.play-example::after { border: none; }

/* 录音 & 评分 */
.entry-row { gap: 16rpx; margin-top: 16rpx; }
.entry-row .record-entry { flex: 1; margin-top: 0; }

/* 难度筛选 */
.scene-picker { margin-top: 16rpx; }

/* 工具行：AB复读/角色扮演 */
.tool-row { display: flex; gap: 12rpx; justify-content: center; margin-top: 24rpx; flex-wrap: wrap; }
.tool-btn { font-size: 24rpx; color: #5A6474; background: #F4F6FC; padding: 14rpx 22rpx; border-radius: 999rpx; }
.tool-btn.on { background: #4A6CF7; color: #fff; }

/* 角色扮演 */
.role-prompt { background: #FFF8E8; border-radius: 16rpx; padding: 24rpx; text-align: left; margin-bottom: 28rpx; }
.role-prompt-title { font-size: 22rpx; color: #E08A1E; margin-bottom: 12rpx; }
.role-prompt-line { font-size: 30rpx; color: #1F2733; line-height: 1.5; }
.role-prompt-line .role-tag { margin: 0 10rpx 0 0; }
.play-other { font-size: 24rpx; color: #E08A1E; margin-top: 12rpx; }

/* 逐词高亮 */
.stage-word.karaoke { line-height: 1.7; }
.k-token { color: #B7BFCC; transition: color .1s; }
.k-token.active { color: #FF9F43; font-weight: 800; text-shadow: 0 0 20rpx rgba(255,159,67,.4); }

/* 播放按钮行 */
.play-btns-row { display: flex; gap: 20rpx; margin: 36rpx 0 0; }

/* 新手引导 */
.guide-mask { position: fixed; inset: 0; background: rgba(31,39,51,.72); z-index: 999; display: flex; align-items: center; justify-content: center; padding: 48rpx; }
.guide-box { background: #fff; border-radius: 28rpx; padding: 48rpx 40rpx; width: 100%; }
.guide-title { font-size: 36rpx; font-weight: 800; margin-bottom: 28rpx; }
.guide-text { font-size: 26rpx; color: #5A6474; line-height: 1.8; margin-bottom: 16rpx; }
.guide-btn { margin-top: 32rpx; text-align: center; background: #4A6CF7; color: #fff; font-size: 30rpx; padding: 22rpx; border-radius: 999rpx; }

.empty { text-align: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.record-zone { margin-top: 32rpx; }
.record-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 180rpx; border: 3rpx dashed #4A6CF7; border-radius: 24rpx; background: #F7F9FF; }
.record-btn.recording { border-color: #FF5C5C; background: #FFF1F1; }
.mic { font-size: 64rpx; line-height: 1; }
.record-label { font-size: 26rpx; color: #4A6CF7; margin-top: 16rpx; }
.record-btn.recording .record-label { color: #FF5C5C; }
.score-box { margin-top: 24rpx; padding: 24rpx; background: #FAFBFF; border-radius: 18rpx; }
.score-wait { font-size: 26rpx; color: #4A6CF7; }
.score-num { font-size: 64rpx; font-weight: 800; line-height: 1; }
.score-num.high { color: #17A873; }
.score-num.mid { color: #E08A1E; }
.score-num.low { color: #FF6B6B; }
.score-unit { font-size: 26rpx; margin-left: 6rpx; }
.score-recognized { font-size: 24rpx; color: #5A6474; margin: 12rpx 0; }
.playback { margin-top: 20rpx; }
.play-mine { display: inline-block; font-size: 28rpx; color: #4A6CF7; background: #EEF2FF; padding: 16rpx 40rpx; border-radius: 999rpx; }
.play-mine.playing { background: #4A6CF7; color: #fff; }
.playback .muted { margin-top: 14rpx; }
.rate-area { margin-top: 32rpx; }
.rate-title { font-size: 26rpx; color: #5A6474; margin-bottom: 20rpx; }
.rate-btns { display: flex; gap: 14rpx; }
.rate-btn { flex: 1; font-size: 24rpx; padding: 20rpx 0; border-radius: 16rpx; }
.rate-btn.again { background: #FFF1F1; color: #FF6B6B; }
.rate-btn.ok { background: #FFF7EC; color: #E08A1E; }
.rate-btn.great { background: #E9F8F1; color: #17A873; }
.stage-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.stage-actions button { flex: 1; }
.empty { text-align: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }

/* 儿童模式星星奖励 */
.star-bar { margin-top: 16rpx; font-size: 28rpx; color: #e8890c; background: #fff8e6; padding: 12rpx 20rpx; border-radius: 12rpx; }
.star-pop { position: fixed; top: 40%; left: 50%; transform: translate(-50%, -50%); font-size: 80rpx; color: #f5a623; z-index: 999; animation: starpop 1.2s ease-out forwards; pointer-events: none; text-shadow: 0 4rpx 16rpx rgba(245,166,35,0.4); }
@keyframes starpop { 0% { opacity: 0; transform: translate(-50%, -30%) scale(0.5); } 30% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); } 100% { opacity: 0; transform: translate(-50%, -120%) scale(1); } }

/* 发音评测明细 */
.score-detail {
  display: flex;
  gap: 14rpx;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8f99;
}
.wrong-words {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #d9822b;
}
.wrong-words .wrong-title { color: #8a8f99; }
.wrong-words .wrong-word { margin-right: 12rpx; }
