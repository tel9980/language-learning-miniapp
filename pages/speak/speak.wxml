<view class="container {{themeClass}}">
  <!-- 新手引导 -->
  <view class="guide-mask" wx:if="{{showGuide}}" bindtap="closeGuide">
    <view class="guide-box" catchtap="">
      <view class="guide-title">欢迎来练习口语 👋</view>
      <view class="guide-text">① 选句子/对话 → ② 听标准发音 → ③ 点麦克风录音 → ④ 听回放对比 → ⑤ 自评打分</view>
      <view class="guide-text">说得不熟的会进「重点复练」，反复攻克。点任意处开始。</view>
      <view class="guide-btn" bindtap="closeGuide">我知道了</view>
    </view>
  </view>

  <!-- 儿童模式星星奖励动画 -->
  <view class="star-pop" wx:if="{{showStar}}">⭐ +1</view>

  <view class="header card">
    <view class="row between">
      <view>
        <view class="title">口语练习 🎤</view>
        <view class="subtitle">跟读 → 录音 → 回放 → 自评/机评</view>
      </view>
      <view class="today-badge">今日 {{todayCount}} 次</view>
    </view>
    <view class="star-bar" wx:if="{{isKid}}">⭐ 已得 {{stars}} 颗星</view>

    <!-- 跟读类型切换 -->
    <view class="track-tabs">
      <view class="tab {{track==='sentence'?'on':''}}" data-track="sentence" bindtap="switchTrack">💬 句子</view>
      <view class="tab {{track==='dialogue'?'on':''}}" data-track="dialogue" bindtap="switchTrack">🎭 对话</view>
      <view class="tab {{track==='word'?'on':''}}" data-track="word" bindtap="switchTrack">📖 单词</view>
      <view class="tab {{track==='custom'?'on':''}}" data-track="custom" bindtap="switchTrack">✏️ 自建</view>
    </view>

    <!-- 等级筛选 -->
    <picker mode="selector" range="{{levelNames}}" value="{{levelIndex}}" bindchange="switchLevel">
      <view class="scene-picker">难度：{{levelNames[levelIndex]}} ▾</view>
    </picker>

    <!-- 对话场景选择 -->
    <picker wx:if="{{track==='dialogue' && scenes.length}}" mode="selector" range="{{sceneNames}}" bindchange="switchScene">
      <view class="scene-picker">场景：{{sceneNames[sceneIndex]}} ▾</view>
    </picker>

    <view class="focus-bar" bindtap="startFocus" wx:if="{{mode==='train'}}">
      <view class="focus-info">
        <view class="focus-title">🎯 重点复练</view>
        <view class="muted">{{focusCount ? '有 ' + focusCount + ' 条说得不够流利，点此集中练' : '练习时点「再练练」可加入重点清单'}}</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="focus-bar returning" bindtap="backToTrain" wx:else>
      <view class="focus-info">
        <view class="focus-title">↩ 返回日常练习</view>
        <view class="muted">重点复练模式 · 共 {{queue.length}} 条</view>
      </view>
      <view class="arrow">›</view>
    </view>

    <view class="row entry-row">
      <view class="record-entry" bindtap="goRecordings">🎧 我的录音 <view class="arrow">›</view></view>
      <view class="record-entry" bindtap="goImport">📥 导入素材 <view class="arrow">›</view></view>
    </view>
  </view>

  <view class="card stage" wx:if="{{current}}">
    <view class="progress-dots" wx:if="{{showDots}}">
      <view wx:for="{{queue}}" wx:key="id" wx:for-index="idx" class="dot {{index===idx?'on':(idx<index?'done':'')}}"></view>
    </view>
    <view class="progress-bar-row" wx:else>
      <view class="progress-bar"><view class="progress-bar-fill" style="width:{{progressPercent}}%"></view></view>
      <view class="progress-text">{{progressText}}</view>
    </view>

    <!-- 角色扮演：显示对方台词 -->
    <view wx:if="{{rolePlay && track==='dialogue'}}" class="role-prompt">
      <view class="role-prompt-title">对方说：</view>
      <view class="role-prompt-line" wx:if="{{otherLine}}">
        <text class="role-tag">{{otherLine.role}}</text> {{otherLine.text}}
        <view class="muted">{{otherLine.cn}}</view>
        <view class="play-other" bindtap="playOtherLine">🔊 听对方说</view>
      </view>
      <view class="muted" wx:else>这是第一句，先听懂对方在说什么</view>
    </view>

    <view wx:if="{{track==='dialogue' && current.role && !rolePlay}}" class="role-tag">{{current.role}}</view>

    <!-- 逐词高亮（K歌字幕） -->
    <view class="stage-word {{track==='sentence'||track==='dialogue'||track==='custom'?'sentence':''}} {{karaokeOn?'karaoke':''}}">
      <block wx:if="{{karaokeOn && karaokeTokens.length}}">
        <text wx:for="{{karaokeTokens}}" wx:key="index" wx:for-index="idx" class="k-token {{item.active?'active':''}}">{{item.text}} </text>
      </block>
      <block wx:else>
        <text wx:if="{{rolePlay && track==='dialogue' && !revealed}}">（想想你要说什么…）</text>
        <text wx:else>{{current.word}}</text>
      </block>
    </view>
    <view class="stage-phonetic" wx:if="{{current.phonetic && !rolePlay}}">{{current.phonetic}}</view>
    <view class="stage-meaning" wx:if="{{!rolePlay}}">{{current.meaning}}</view>
    <view class="scene-tag" wx:if="{{current.scene}}">#{{current.scene}} <text wx:if="{{current.level}}"> · {{current.level}}</text></view>

    <view class="play-btns-row">
      <button class="play-btn" bindtap="playSlow">🐢 慢速</button>
      <button class="play-btn primary" bindtap="playStd">▶️ 标准发音</button>
    </view>

    <!-- A-B 复读 / 角色扮演 / 显示台词 -->
    <view class="tool-row">
      <view class="tool-btn {{abLoop?'on':''}}" bindtap="toggleAB">🔁 A-B复读<text wx:if="{{abLoop}}"> ×{{abCount}}</text></view>
      <view class="tool-btn {{rolePlay?'on':''}}" bindtap="toggleRolePlay" wx:if="{{track==='dialogue'}}">🎭 角色扮演</view>
      <view class="tool-btn" bindtap="revealLine" wx:if="{{rolePlay && track==='dialogue' && !revealed}}">👁 显示台词</view>
    </view>

    <view class="example-box" wx:if="{{current.example && current.example !== current.word && !rolePlay}}">
      <view class="example-title">开口例句 · 跟着说</view>
      <view class="example-en">{{current.example}}</view>
      <view class="example-cn">{{current.exampleCn}}</view>
      <button class="play-example" bindtap="playExample">🔊 听例句</button>
    </view>

    <view class="record-zone">
      <view class="record-btn {{recording?'recording':''}}" bindtap="toggleRecord">
        <view class="mic">{{recording?'⏹':'🎤'}}</view>
        <view class="record-label">{{recording?'点此停止录音':'点此开始录音跟读'}}</view>
      </view>

      <view class="score-box" wx:if="{{scoreSupported}}">
        <block wx:if="{{scoring}}"><view class="score-wait">🔍 正在识别发音…</view></block>
        <block wx:elif="{{score !== null}}">
          <view class="score-num {{score>=80?'high':(score>=60?'mid':'low')}}">{{score}}<text class="score-unit">分</text></view>
          <view class="score-detail" wx:if="{{scoreDetail}}">
            <text>准确 {{scoreDetail.accuracy}}</text>
            <text wx:if="{{scoreDetail.fluency}}">流畅 {{scoreDetail.fluency}}</text>
            <text wx:if="{{scoreDetail.completion}}">完整 {{scoreDetail.completion}}</text>
          </view>
          <view class="score-recognized" wx:if="{{recognized}}">识别到：{{recognized}}</view>
          <view class="wrong-words" wx:if="{{wrongWords.length}}">
            <text class="wrong-title">需要练的词：</text>
            <text class="wrong-word" wx:for="{{wrongWords}}" wx:key="word">{{item.word}}（{{item.tagText}}）</text>
          </view>
          <view class="muted">客观参考分，结合自评一起看</view>
        </block>
        <block wx:else><view class="muted">录音后将给出客观发音参考分</view></block>
      </view>

      <view class="playback" wx:if="{{hasRecording}}">
        <view class="play-mine {{playingMine?'playing':''}}" bindtap="playMine">▶️ 听我的回放</view>
        <view class="muted">对比标准音，看看哪里可以更像</view>
      </view>
    </view>

    <view class="rate-area" wx:if="{{hasRecording}}">
      <view class="rate-title">说得怎么样？</view>
      <view class="rate-btns">
        <view class="rate-btn again" data-q="0" bindtap="rate">🔁 再练练</view>
        <view class="rate-btn ok" data-q="1" bindtap="rate">👍 基本流利</view>
        <view class="rate-btn great" data-q="2" bindtap="rate">🌟 很流利</view>
      </view>
    </view>

    <view class="stage-actions">
      <button class="btn-ghost" bindtap="prev" wx:if="{{index>0}}">上一个</button>
      <button class="btn-ghost" bindtap="next">跳过 ›</button>
    </view>
  </view>

  <view class="empty card" wx:else>
    <view class="empty-icon">🎧</view>
    <view class="title">暂无跟读内容</view>
    <view class="muted">{{track==='custom'?'点上方「导入素材」添加自己的句子':'切换类型或难度试试'}}</view>
  </view>
</view>
