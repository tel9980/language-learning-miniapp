<view class="container {{themeClass}}">
  <view class="search-bar card">
    <view class="search-icon">🔍</view>
    <input class="search-input" placeholder="搜索单词、释义或例句" confirm-type="search"
           value="{{keyword}}" bindinput="onInput" bindconfirm="onConfirm" />
    <view class="clear-btn" wx:if="{{keyword}}" bindtap="clearKeyword">✕</view>
  </view>

  <view class="mode-row">
    <view class="mode-btn {{showMode === 'all' ? 'active' : ''}}" data-mode="all" bindtap="setMode">全部单词</view>
    <view class="mode-btn {{showMode === 'fav' ? 'active' : ''}}" data-mode="fav" bindtap="setMode">⭐ 我的收藏</view>
  </view>

  <view class="history-row" wx:if="{{historyList.length > 0 && !keyword}}">
    <view class="history-head"><text class="muted">最近搜索</text><text class="clear-history" bindtap="clearHistory">清空</text></view>
    <view class="history-chips">
      <view class="history-chip" wx:for="{{historyList}}" wx:key="*this" data-kw="{{item}}" bindtap="searchHistory">{{item}}</view>
    </view>
  </view>

  <view class="filter-row">
    <view class="filter-label">{{langName}} · 分类</view>
    <picker bindchange="onCatChange" value="{{catIndex}}" range="{{categories}}">
      <view class="filter-picker">{{categories[catIndex]}} ▾</view>
    </picker>
    <view class="result-count">共 {{resultCount}} 词</view>
  </view>

  <view class="result-list">
    <view class="word-item card" wx:for="{{results}}" wx:for-index="idx" wx:key="id"
          data-id="{{item.id}}" bindtap="toggleDetail">
      <view class="word-head">
        <view class="word-main">
          <text class="word-text">{{item.word}}</text>
          <text class="word-phonetic">{{item.phonetic}}</text>
        </view>
        <view class="play-btn" data-word="{{item.word}}" data-id="{{item.id}}" catchtap="playWord">🔊</view>
        <view class="fav-btn {{favIds.indexOf(item.id) >= 0 ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleFav">{{favIds.indexOf(item.id) >= 0 ? '⭐' : '☆'}}</view>
      </view>
      <view class="word-meaning">{{item.meaning}}</view>
      <view class="word-cat">{{item.category}}</view>

      <view class="word-detail" wx:if="{{expandedId === item.id}}">
        <view class="detail-label">例句</view>
        <view class="detail-en">{{item.example}}</view>
        <view class="detail-cn">{{item.exampleCn}}</view>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更多（已显示 {{results.length}}/{{resultCount}}）</view>

    <view class="empty" wx:if="{{resultCount === 0}}">
      <view class="empty-icon">🔎</view>
      <view>没有找到匹配的单词，换个关键词试试</view>
    </view>
  </view>
</view>
