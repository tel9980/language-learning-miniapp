.hero { padding: 40rpx 32rpx 24rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; color: #1f2430; }
.hero-sub { font-size: 26rpx; color: #8a94a6; margin-top: 8rpx; }

.stat-row { display: flex; gap: 16rpx; padding: 0 32rpx 20rpx; }
.stat-box { flex: 1; border-radius: 20rpx; padding: 24rpx 0; text-align: center; }
.stat-box.due { background: #eef2ff; }
.stat-box.focus { background: #fff4e6; }
.stat-box.wrong { background: #ffeef0; }
.stat-num { font-size: 48rpx; font-weight: 700; color: #4A6CF7; }
.stat-box.focus .stat-num { color: #e8890c; }
.stat-box.wrong .stat-num { color: #e5484d; }
.stat-label { font-size: 24rpx; color: #8a94a6; margin-top: 4rpx; }

.list-card { margin: 0 32rpx 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #1f2430; margin-bottom: 16rpx; }
.item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f7; }
.item:last-child { border-bottom: none; }
.item-badge { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 12rpx; margin-right: 20rpx; white-space: nowrap; }
.item-badge.due { background: #eef2ff; color: #4A6CF7; }
.item-badge.focus { background: #fff4e6; color: #e8890c; }
.item-badge.wrong { background: #ffeef0; color: #e5484d; }
.item-main { flex: 1; min-width: 0; }
.item-label { font-size: 30rpx; color: #1f2430; font-weight: 500; }
.item-sub { font-size: 24rpx; color: #8a94a6; margin-top: 4rpx; }
.item-arrow { font-size: 40rpx; color: #c5ccd8; margin-left: 12rpx; }

.empty-card { margin: 40rpx 32rpx; text-align: center; padding: 60rpx 32rpx; }
.empty-emoji { font-size: 96rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; margin: 20rpx 0 12rpx; }
.muted { color: #8a94a6; font-size: 26rpx; line-height: 1.6; }
.quick-btns { display: flex; gap: 16rpx; margin-top: 40rpx; }
.quick-btn { flex: 1; background: #eef2ff; color: #4A6CF7; font-size: 26rpx; padding: 20rpx 0; border-radius: 16rpx; }
