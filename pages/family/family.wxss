.header { margin-bottom: 20rpx; }
.header .title { font-size: 36rpx; font-weight: 700; color: #1F2430; }
.sorts { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.sort { flex: 1; text-align: center; font-size: 26rpx; color: #6B7280; background: #fff; border: 1rpx solid #E4E8F2; border-radius: 12rpx; padding: 14rpx 0; }
.sort.active { color: #fff; background: #4A6CF7; border-color: #4A6CF7; }
.row { display: flex; align-items: center; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.row.me { border: 2rpx solid #4A6CF7; }
.rank { width: 48rpx; font-size: 32rpx; font-weight: 700; color: #B7BFCC; text-align: center; }
.rank.top { color: #F5A623; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #EEF2FF; text-align: center; line-height: 72rpx; font-size: 36rpx; margin: 0 16rpx; }
.info { flex: 1; }
.name { font-size: 28rpx; font-weight: 600; color: #1F2430; }
.me-tag { font-size: 18rpx; color: #4A6CF7; background: #EEF2FF; padding: 2rpx 8rpx; border-radius: 6rpx; }
.score { font-size: 36rpx; font-weight: 700; color: #4A6CF7; }

/* ===== 深色模式（第九轮补：本页原来 0 处） ===== */
.theme-dark .header .title { color: #E8EAF0; }
.theme-dark .sort { background: #262D3D; border-color: #333C50; color: #9AA3B5; }
.theme-dark .sort.active { background: #4A6CF7; border-color: #4A6CF7; color: #fff; }
.theme-dark .row.me { border-color: #4A6CF7; }
.theme-dark .rank { color: #5A6478; }
.theme-dark .avatar { background: #2E3648; }
.theme-dark .name { color: #E8EAF0; }
.theme-dark .me-tag { background: #2A3350; color: #8FA8FF; }
.theme-dark .score { color: #8FA8FF; }
