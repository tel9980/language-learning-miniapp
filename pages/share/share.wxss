.hero { text-align: center; padding: 48rpx 24rpx; margin-bottom: 24rpx; }
.big { font-size: 96rpx; }
.hero .title { font-size: 38rpx; font-weight: 700; color: #1F2430; margin: 16rpx 0 12rpx; }
.step { display: flex; align-items: center; margin-bottom: 16rpx; }
.step-num { width: 56rpx; height: 56rpx; border-radius: 50%; background: #4A6CF7; color: #fff; text-align: center; line-height: 56rpx; font-weight: 700; margin-right: 20rpx; flex-shrink: 0; }
.step-title { font-size: 28rpx; color: #1F2430; margin-bottom: 6rpx; }
.share-btn { background: #4A6CF7; color: #fff; border-radius: 16rpx; font-size: 30rpx; padding: 20rpx 0; margin: 16rpx 0; }
.copy-btn { text-align: center; color: #4A6CF7; font-size: 28rpx; padding: 20rpx 0; }
.tip-card { background: #F7F9FD; margin-top: 16rpx; }
.tip { line-height: 1.6; }
