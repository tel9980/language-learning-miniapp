.mode-tabs { display: flex; background: #E9EDF7; border-radius: 999rpx; padding: 6rpx; margin-bottom: 36rpx; }
.mode-tab { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; color: #8A94A6; border-radius: 999rpx; }
.mode-tab.active { background: #fff; color: #4A6CF7; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.card-wrap { perspective: 1200rpx; }
.flashcard {
  position: relative; width: 100%; height: 640rpx;
  transform-style: preserve-3d; transition: transform 0.5s;
}
.flashcard.flipped { transform: rotateY(180deg); }
.face {
  position: absolute; width: 100%; height: 100%;
  backface-visibility: hidden; -webkit-backface-visibility: hidden;
  border-radius: 28rpx; box-shadow: 0 12rpx 40rpx rgba(74,108,247,0.14);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 40rpx; box-sizing: border-box;
}
.front { background: linear-gradient(160deg, #4A6CF7, #6E8BFF); color: #fff; }
.back { background: #fff; transform: rotateY(180deg); }
.category { position: absolute; top: 40rpx; font-size: 22rpx; background: rgba(255,255,255,0.2); padding: 8rpx 20rpx; border-radius: 999rpx; }
.word { font-size: 72rpx; font-weight: 800; letter-spacing: 2rpx; }
.phonetic { font-size: 30rpx; opacity: 0.85; margin-top: 20rpx; }
.tap-hint { position: absolute; bottom: 44rpx; font-size: 24rpx; opacity: 0.8; }
.word-small { font-size: 34rpx; color: #4A6CF7; font-weight: 700; }
.meaning { font-size: 40rpx; font-weight: 700; margin-top: 24rpx; text-align: center; }
.divider { width: 80rpx; height: 4rpx; background: #EEF1FB; margin: 32rpx 0; border-radius: 4rpx; }
.example { font-size: 28rpx; text-align: center; color: #1F2733; line-height: 1.6; }
.example-cn { font-size: 24rpx; text-align: center; color: #8A94A6; margin-top: 12rpx; line-height: 1.6; }
.extra { margin-top: 20rpx; width: 100%; }
.col { font-size: 22rpx; text-align: center; color: #4A6CF7; background: #EEF2FF; border-radius: 999rpx; padding: 6rpx 0; }
.ex2 { font-size: 24rpx; text-align: center; color: #3A4250; line-height: 1.5; margin-top: 16rpx; }
.ex2-cn { font-size: 22rpx; text-align: center; color: #8A94A6; line-height: 1.5; margin-top: 6rpx; }
.speak-btn { text-align: center; color: #4A6CF7; font-size: 28rpx; padding: 24rpx; }
/* 「早就认识」：学新词时的免评分出口，视觉上要比三个评分键轻，别抢注意力 */
.known-skip {
  text-align: center; font-size: 24rpx; color: #8A94A6;
  padding: 18rpx 24rpx; margin: 0 auto; max-width: 70%;
  border: 1px dashed #D5DBE6; border-radius: 999rpx;
}
.known-skip:active { background: #F2F5FA; }
/* 误点之后的撤销入口 */
.known-undo { text-align: center; font-size: 22rpx; color: #8A94A6; margin-top: 12rpx; text-decoration: underline; }
.theme-dark .known-skip { color: #9AA3B5; border-color: #3B455C; }
.theme-dark .known-skip:active { background: #2A3244; }
.theme-dark .known-undo { color: #9AA3B5; }
.rate-area { margin-top: 12rpx; }
.rate-title { text-align: center; font-size: 26rpx; color: #8A94A6; margin-bottom: 20rpx; }
.rate-btns { display: flex; gap: 16rpx; }
.rate-btn { flex: 1; font-size: 26rpx; border-radius: 999rpx; padding: 6rpx 0; }
.rate-btn::after { border: none; }
.forgot { background: #FFEBEB; color: #F05A5A; }
.fuzzy { background: #FFF4E0; color: #E8952F; }
.known { background: #E4F7EE; color: #22A06B; }
.empty { text-align: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty .title { margin-bottom: 12rpx; }
.empty-btn { margin-top: 40rpx; width: 60%; }
.progress-line { text-align: center; font-size: 24rpx; color: #8A94A6; margin-top: 28rpx; }

/* 学新词时的分类下拉 */
.cat-row { display: flex; justify-content: center; margin: -8rpx 0 24rpx; }
.cat-picker {
  background: #EDF1FF;
  color: #4A6CF7;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}

/* 深色模式：卡片背面与新增的搭配/第二例句 */
.theme-dark .back { background: #262D3D; color: #E8EAF0; }
.theme-dark .example { color: #E8EAF0; }
.theme-dark .divider { background: #3B455C; }
.theme-dark .col { background: #333C50; color: #8FA8FF; }
.theme-dark .ex2 { color: #C9D2E3; }
.theme-dark .ex2-cn { color: #9AA3B5; }

/* ===== 第九轮：学完新词后的下一步引导 ===== */
.next-steps { margin-top: 40rpx; padding-top: 28rpx; border-top: 1rpx solid #EEF1FB; }
.next-title { font-size: 26rpx; color: #8A94A6; margin-bottom: 20rpx; }
.next-btn { font-size: 30rpx; color: #4A6CF7; background: #F3F6FF; border: 1rpx solid #DDE4FF; border-radius: 16rpx; padding: 24rpx 0; margin-bottom: 16rpx; }
.next-btn:active { background: #E6ECFF; }
.theme-dark .next-steps { border-top-color: #2E3648; }
.theme-dark .next-title { color: #9AA3B5; }
.theme-dark .next-btn { color: #8FA8FF; background: #232B45; border-color: #33406B; }
.theme-dark .next-btn:active { background: #2A3350; }
