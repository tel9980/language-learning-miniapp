<view class="container {{themeClass}}">
  <view class="summary card">
    <view class="summary-item">
      <view class="s-num">{{stats.streak}}</view>
      <view class="s-label">连续打卡</view>
    </view>
    <view class="summary-item">
      <view class="s-num">{{mastered}}</view>
      <view class="s-label">已掌握词</view>
    </view>
    <view class="summary-item">
      <view class="s-num">{{accuracy}}%</view>
      <view class="s-label">总正确率</view>
    </view>
  </view>

  <view class="card speak-card">
    <view class="section-title">🎤 口语练习</view>
    <view class="speak-stats">
      <view class="speak-item">
        <view class="s-num">{{speak.practiced}}</view>
        <view class="s-label">练过的词</view>
      </view>
      <view class="speak-item">
        <view class="s-num">{{speak.fluent}}</view>
        <view class="s-label">说得流利</view>
      </view>
      <view class="speak-item">
        <view class="s-num">{{speak.focus}}</view>
        <view class="s-label">重点待练</view>
      </view>
    </view>
  </view>

  <view class="card chart-card">
    <view class="section-title">近 7 天复习量</view>
    <view class="chart-wrap">
      <canvas type="2d" id="barChart" class="chart"></canvas>
    </view>
  </view>

  <view class="card chart-card">
    <view class="section-title">近 14 天口语流利度 <text class="muted">（流利数 ÷ 练习数）</text></view>
    <view class="chart-wrap">
      <canvas type="2d" id="fluencyChart" class="chart"></canvas>
    </view>
  </view>

  <view class="card calendar-card">
    <view class="section-title">打卡日历 <text class="muted">（近 4 周）</text></view>
    <view class="cal-grid">
      <view wx:for="{{calendar}}" wx:key="key" class="cal-cell {{item.active?'active':''}} {{item.speak?'speak':''}}" title="{{item.key}}">
        {{item.day}}
      </view>
    </view>
    <view class="cal-legend">
      <view class="legend-item"><view class="legend-dot done"></view>已打卡</view>
      <view class="legend-item"><view class="legend-dot sp"></view>有口语</view>
      <view class="legend-item"><view class="legend-dot none"></view>未打卡</view>
    </view>
  </view>

  <view class="card badges-card">
    <view class="section-title">成就徽章 <text class="muted">（已解锁 {{unlockedCount}}/{{badges.length}}）</text></view>
    <view class="badge-grid">
      <view wx:for="{{badges}}" wx:key="id" class="badge-item {{item.unlocked?'unlocked':'locked'}}">
        <view class="badge-icon">{{item.icon}}</view>
        <view class="badge-name">{{item.name}}</view>
        <view class="badge-progress">{{item.unlocked?'已解锁':item.progress}}</view>
      </view>
    </view>
  </view>

  <view class="card levels-card">
    <view class="section-title">词汇掌握分布</view>
    <view wx:for="{{levels}}" wx:key="name" class="level-row">
      <view class="level-name">{{item.name}}</view>
      <view class="level-track">
        <view class="level-fill" style="width:{{item.percent}}%;background:{{item.color}}"></view>
      </view>
      <view class="level-count">{{item.count}}</view>
    </view>
  </view>

  <view class="card goal-card">
    <view class="row between">
      <view class="section-title">每日目标</view>
      <view class="goal-edit" bindtap="editGoal">修改 ✎</view>
    </view>
    <view class="muted">每天复习 {{dailyGoal}} 个词，保持学习习惯</view>
  </view>

  <view class="card data-card">
    <view class="section-title">学习数据备份</view>
    <view class="muted">换设备时用导出/导入迁移学习进度，无需联网或账号</view>
    <view class="data-btns">
      <view class="data-btn export" bindtap="exportProgress">导出进度</view>
      <view class="data-btn import" bindtap="importProgress">导入进度</view>
    </view>
    <view class="muted" style="margin-top:20rpx">一家人换设备？用全家包一次搬走所有人的进度</view>
    <view class="data-btns">
      <view class="data-btn export" bindtap="exportFamily">导出全家包</view>
      <view class="data-btn import" bindtap="importFamily">导入全家包</view>
    </view>
  </view>

  <view class="card settings-card">
    <view class="section-title">⚙️ 使用设置</view>
    <view class="setting-row" bindtap="setFontSize">
      <view class="setting-label">🔤 字体大小</view>
      <view class="setting-value">{{fontScale>=1.3?'超大':(fontScale>=1.14?'大':(fontScale<=0.9?'小':'标准'))}} ›</view>
    </view>
    <view class="setting-row" bindtap="toggleDarkMode">
      <view class="setting-label">🌙 深色模式</view>
      <view class="switch {{darkMode?'on':''}}"><view class="knob"></view></view>
    </view>
    <view class="setting-row" bindtap="clearTtsCache">
      <view class="setting-label">🔊 发音缓存</view>
      <view class="setting-value">{{ttsCacheKb>0?(ttsCacheKb+'KB · 清理'):'空'}} ›</view>
    </view>
    <view class="setting-row" bindtap="openOfflineAudio">
      <view class="setting-label">🗣 离线发音包</view>
      <view class="setting-value">查看 ›</view>
    </view>
    <view class="setting-row" bindtap="checkOnline">
      <view class="setting-label">🔄 在线词库</view>
      <view class="setting-value">立即检查 ›</view>
    </view>

    <view class="setting-row" bindtap="toggleFeedback">
      <view class="setting-label">📳 触感反馈</view>
      <view class="switch {{feedbackEnabled?'on':''}}"><view class="knob"></view></view>
    </view>
  </view>
</view>
