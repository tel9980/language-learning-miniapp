.summary { display: flex; margin-bottom: 24rpx; }
.summary-item { flex: 1; text-align: center; }
.s-num { font-size: 52rpx; font-weight: 800; color: #4A6CF7; }
.s-label { font-size: 22rpx; color: #8A94A6; margin-top: 8rpx; }
.chart-card, .levels-card, .goal-card, .data-card, .speak-card, .calendar-card, .badges-card, .settings-card { margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }
.muted { font-size: 24rpx; color: #8A94A6; line-height: 1.6; }
.row.between { display: flex; justify-content: space-between; align-items: center; }
.speak-stats { display: flex; }
.speak-item { flex: 1; text-align: center; }
.speak-item .s-num { font-size: 52rpx; }
.chart-wrap { width: 100%; height: 360rpx; }
.chart { width: 100%; height: 360rpx; }
.level-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.level-name { width: 120rpx; font-size: 24rpx; color: #5A6474; }
.level-track { flex: 1; height: 18rpx; background: #EEF1FB; border-radius: 999rpx; overflow: hidden; }
.level-fill { height: 100%; border-radius: 999rpx; transition: width 0.3s; }
.level-count { width: 50rpx; text-align: right; font-size: 24rpx; color: #8A94A6; }
.goal-edit { font-size: 24rpx; color: #4A6CF7; }
.data-btns { display: flex; margin-top: 24rpx; }
.data-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  margin-right: 16rpx;
}
.data-btn:last-child { margin-right: 0; }
.data-btn.export { background: #4A6CF7; color: #fff; }
.data-btn.import { background: #EDF1FF; color: #4A6CF7; }

/* 打卡日历 */
.cal-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cal-cell {
  width: calc((100% - 6 * 12rpx) / 7);
  aspect-ratio: 1;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #B7BFCC; background: #F4F6FC; border-radius: 10rpx;
}
.cal-cell.active { background: #7E9BFF; color: #fff; }
.cal-cell.active.speak { background: #4A6CF7; }
.cal-legend { display: flex; gap: 24rpx; margin-top: 20rpx; }
.legend-item { display: flex; align-items: center; font-size: 22rpx; color: #8A94A6; }
.legend-dot { width: 18rpx; height: 18rpx; border-radius: 4rpx; margin-right: 8rpx; }
.legend-dot.done { background: #7E9BFF; }
.legend-dot.sp { background: #4A6CF7; }
.legend-dot.none { background: #F4F6FC; border: 1rpx solid #E4E8F2; }

/* 成就徽章 */
.badge-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.badge-item { width: calc((100% - 32rpx) / 3); text-align: center; padding: 20rpx 8rpx; border-radius: 16rpx; background: #F7F9FE; }
.badge-item.unlocked { background: #FFF8E8; }
.badge-icon { font-size: 52rpx; filter: grayscale(1); opacity: .4; }
.badge-item.unlocked .badge-icon { filter: none; opacity: 1; }
.badge-name { font-size: 24rpx; font-weight: 600; margin-top: 8rpx; color: #8A94A6; }
.badge-item.unlocked .badge-name { color: #E08A1E; }
.badge-progress { font-size: 20rpx; color: #B7BFCC; margin-top: 6rpx; }

/* 使用设置 */
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #F0F2F8; }
.setting-row:last-child { border-bottom: none; }
.setting-label { font-size: 28rpx; color: #1F2733; }
.setting-value { font-size: 26rpx; color: #8A94A6; }
.switch { width: 88rpx; height: 50rpx; border-radius: 999rpx; background: #E4E8F2; position: relative; transition: background .2s; }
.switch.on { background: #4A6CF7; }
.knob { position: absolute; top: 4rpx; left: 4rpx; width: 42rpx; height: 42rpx; border-radius: 50%; background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.15); transition: left .2s; }
.switch.on .knob { left: 42rpx; }
