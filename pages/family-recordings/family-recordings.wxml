<view class="container {{themeClass}}">
  <view class="header card">
    <view class="title">🎧 全家录音墙</view>
    <view class="muted">听听家人的练习，点"点评"互相鼓励</view>
  </view>
  <view wx:for="{{list}}" wx:key="id" class="card rec">
    <view class="row between">
      <view class="owner"><text class="avatar">{{item.ownerAvatar}}</text> {{item.ownerName}}</view>
      <view class="muted time">{{item.timeText}}</view>
    </view>
    <view class="label">{{item.label || '口语练习'}}</view>
    <view wx:if="{{item.cn}}" class="muted cn">{{item.cn}}</view>
    <view class="rec-actions">
      <view class="btn play" bindtap="play" data-id="{{item.id}}">{{playingId==item.id?'⏸ 停止':'▶ 播放'}}</view>
      <view class="btn comment" bindtap="comments" data-id="{{item.id}}">💬 点评{{item.commentCount>0?'('+item.commentCount+')':''}}</view>
    </view>
  </view>
  <view wx:if="{{list.length==0}}" class="card empty muted">全家还没有录音。先去「口语」练一句并录音吧～</view>
</view>
