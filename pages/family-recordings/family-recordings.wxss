.header { margin-bottom: 20rpx; }
.header .title { font-size: 36rpx; font-weight: 700; color: #1F2430; }
.rec { margin-bottom: 20rpx; }
.owner { font-size: 26rpx; font-weight: 600; color: #1F2430; }
.avatar { margin-right: 8rpx; }
.time { font-size: 22rpx; }
.label { font-size: 30rpx; color: #1F2430; margin: 16rpx 0 8rpx; }
.cn { font-size: 24rpx; }
.rec-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 12rpx; font-size: 26rpx; }
.btn.play { background: #EEF2FF; color: #4A6CF7; }
.btn.comment { background: #FFF4E5; color: #E48A00; }
.empty { text-align: center; padding: 60rpx 24rpx; }
