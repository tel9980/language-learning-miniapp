.quiz-head { margin-bottom: 28rpx; }
.progress-track { height: 12rpx; background: #E9EDF7; border-radius: 999rpx; margin-top: 18rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #4A6CF7; border-radius: 999rpx; transition: width 0.3s; }
.score-row { display: flex; gap: 16rpx; margin-top: 18rpx; }
.score-chip { font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 999rpx; }
.score-chip.correct { background: #E4F7EE; color: #22A06B; }
.score-chip.wrong { background: #FFEBEB; color: #F05A5A; }
.question-card { min-height: 700rpx; }
.q-type { display: inline-block; font-size: 22rpx; color: #4A6CF7; background: #EEF2FF; padding: 8rpx 18rpx; border-radius: 999rpx; }
.q-prompt { font-size: 36rpx; font-weight: 700; margin: 32rpx 0 12rpx; line-height: 1.5; }
.q-hint { font-size: 30rpx; color: #8A94A6; margin: 20rpx 0 40rpx; line-height: 1.6; }
.options { margin-top: 36rpx; }
.option { display: flex; align-items: center; padding: 28rpx; border: 2rpx solid #EEF1FB; border-radius: 16rpx; margin-bottom: 18rpx; font-size: 28rpx; transition: all 0.2s; }
.opt-letter { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 50%; background: #F0F3FA; color: #8A94A6; font-size: 24rpx; margin-right: 20rpx; }
.option.selected { border-color: #4A6CF7; background: #F5F7FF; }
.option.selected .opt-letter { background: #4A6CF7; color: #fff; }
.option.right { border-color: #22A06B; background: #EDFBF4; }
.option.right .opt-letter { background: #22A06B; color: #fff; }
.option.wrong { border-color: #F05A5A; background: #FFF0F0; }
.option.wrong .opt-letter { background: #F05A5A; color: #fff; }
.spell-box { margin: 48rpx 0; }
.spell-input { width: 100%; border: 2rpx solid #E4E8F2; border-radius: 16rpx; padding: 28rpx; font-size: 32rpx; box-sizing: border-box; }
.feedback { margin-top: 32rpx; border-radius: 16rpx; padding: 24rpx; }
.fb-right { background: #EDFBF4; }
.fb-wrong { background: #FFF0F0; }
.fb-title { font-size: 28rpx; font-weight: 700; margin-bottom: 10rpx; }
.fb-right .fb-title { color: #22A06B; }
.fb-wrong .fb-title { color: #F05A5A; }
.fb-answer { font-size: 26rpx; margin-bottom: 8rpx; }
.fb-example { font-size: 24rpx; color: #8A94A6; line-height: 1.5; }
.action-btn { width: 100%; margin-top: 36rpx; }
.result { text-align: center; padding: 80rpx 40rpx; }
.result-emoji { font-size: 100rpx; }
.result-title { font-size: 32rpx; font-weight: 700; margin-top: 16rpx; }
.result-accuracy { font-size: 96rpx; font-weight: 800; color: #4A6CF7; margin-top: 24rpx; }
.result-sub { font-size: 24rpx; color: #8A94A6; }
.result-detail { font-size: 26rpx; margin-top: 24rpx; }
.quiz-hint { margin-top: 8rpx; }
.result-btn { width: 100%; margin-top: 32rpx; }

/* ===== 深色模式（第九轮补：本页原来 0 处 .theme-dark，选项/反馈块在深色下都是亮块） ===== */
.theme-dark .progress-track { background: #2A3244; }
.theme-dark .score-chip.correct { background: #1B3329; color: #4ADE9B; }
.theme-dark .score-chip.wrong { background: #3A2124; color: #FF9A9A; }
.theme-dark .q-type { background: #2A3350; color: #8FA8FF; }
.theme-dark .option { border-color: #333C50; }
.theme-dark .opt-letter { background: #2E3648; color: #9AA3B5; }
.theme-dark .option.selected { border-color: #4A6CF7; background: #232B45; }
.theme-dark .option.selected .opt-letter { background: #4A6CF7; color: #fff; }
.theme-dark .option.right { border-color: #22A06B; background: #1B3329; }
.theme-dark .option.right .opt-letter { background: #22A06B; color: #fff; }
.theme-dark .option.wrong { border-color: #F05A5A; background: #3A2124; }
.theme-dark .option.wrong .opt-letter { background: #F05A5A; color: #fff; }
.theme-dark .spell-input { border-color: #333C50; background: #232B3C; color: #E8EAF0; }
.theme-dark .fb-right { background: #1B3329; }
.theme-dark .fb-wrong { background: #3A2124; }
.theme-dark .result-accuracy { color: #8FA8FF; }
.theme-dark .result-title { color: #E8EAF0; }
