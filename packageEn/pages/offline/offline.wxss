.wrap { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; color: #1F2733; margin-bottom: 12rpx; }
.desc { font-size: 24rpx; color: #6B7686; line-height: 1.6; margin-bottom: 20rpx; }
.row { display: flex; align-items: center; padding: 16rpx 0; border-top: 1rpx solid #EEF1F6; }
.k { width: 120rpx; font-size: 28rpx; color: #1F2733; }
.v { flex: 1; font-size: 26rpx; color: #6B7686; }
.s { font-size: 24rpx; }
.s.ok { color: #16A34A; }
.s.wait { color: #D97706; }
.btn { margin-top: 24rpx; }
.item { padding: 18rpx 0; border-top: 1rpx solid #EEF1F6; }
.jp { display: block; font-size: 30rpx; color: #1F2733; }
.cn { display: block; font-size: 24rpx; color: #8A94A6; margin-top: 6rpx; }
.tip { font-size: 22rpx; color: #A0A8B4; margin-top: 16rpx; }
