page {
  background: #F5F7FB;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1F2733;
}
.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 108, 247, 0.08);
}
.btn-primary {
  background: #4A6CF7;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary::after { border: none; }
.btn-ghost {
  background: #FFFFFF;
  color: #4A6CF7;
  border: 2rpx solid #4A6CF7;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.title { font-size: 36rpx; font-weight: 700; }
.subtitle { font-size: 26rpx; color: #8A94A6; }
.muted { color: #8A94A6; font-size: 24rpx; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }

/* ===== 无障碍：字号与深色模式（页面 root 挂 themeClass） =====

   ⚠️ 这里必须用 rpx 绝对值，不能用 %。
   原因（第九轮实测发现的老 bug）：页面里的正文字号全是 rpx 绝对值——
   .stage-word 64rpx(32px)、.word 72rpx(36px)、.meaning 40rpx、.option 28rpx。
   而 page / .container 都没设 font-size，% 只能相对继承来的 16px 默认值算：
     .theme-xl .stage-word 写 125% → 16px × 1.25 = 20px
   于是「选超大字号」把 32px 的大单词缩成 20px，方向刚好反了。
   而 .theme-xl .stage-word（两个类）优先级又高于 .stage-word（一个类），一定赢。
   现在改成按倍率直接给 rpx，和下面 .theme-kid 的写法保持一致。

   倍率：小 0.9 / 大 1.18 / 超大 1.35（与 pages/stats/stats.js 的 scales 一致） */
.theme-sm .word { font-size: 65rpx; }
.theme-sm .stage-word { font-size: 58rpx; }
.theme-sm .stage-word.sentence { font-size: 32rpx; }
.theme-sm .meaning { font-size: 36rpx; }
.theme-sm .stage-meaning { font-size: 27rpx; }
.theme-sm .phonetic,
.theme-sm .stage-phonetic { font-size: 25rpx; }
.theme-sm .example,
.theme-sm .example-en { font-size: 25rpx; }
.theme-sm .example-cn { font-size: 22rpx; }
.theme-sm .q-prompt { font-size: 32rpx; }
.theme-sm .q-hint { font-size: 27rpx; }
.theme-sm .option { font-size: 25rpx; }
.theme-sm .spell-input { font-size: 29rpx; }
.theme-sm .title { font-size: 32rpx; }
.theme-sm .subtitle { font-size: 23rpx; }
.theme-sm .muted { font-size: 22rpx; }

.theme-lg .word { font-size: 85rpx; }
.theme-lg .stage-word { font-size: 76rpx; }
.theme-lg .stage-word.sentence { font-size: 42rpx; }
.theme-lg .meaning { font-size: 47rpx; }
.theme-lg .stage-meaning { font-size: 35rpx; }
.theme-lg .phonetic,
.theme-lg .stage-phonetic { font-size: 33rpx; }
.theme-lg .example,
.theme-lg .example-en { font-size: 33rpx; }
.theme-lg .example-cn { font-size: 28rpx; }
.theme-lg .q-prompt { font-size: 42rpx; }
.theme-lg .q-hint { font-size: 35rpx; }
.theme-lg .option { font-size: 33rpx; }
.theme-lg .spell-input { font-size: 38rpx; }
.theme-lg .title { font-size: 42rpx; }
.theme-lg .subtitle { font-size: 31rpx; }
.theme-lg .muted { font-size: 28rpx; }

.theme-xl .word { font-size: 97rpx; }
.theme-xl .stage-word { font-size: 86rpx; }
.theme-xl .stage-word.sentence { font-size: 49rpx; }
.theme-xl .meaning { font-size: 54rpx; }
.theme-xl .stage-meaning { font-size: 41rpx; }
.theme-xl .phonetic,
.theme-xl .stage-phonetic { font-size: 38rpx; }
.theme-xl .example,
.theme-xl .example-en { font-size: 38rpx; }
.theme-xl .example-cn { font-size: 32rpx; }
.theme-xl .q-prompt { font-size: 49rpx; }
.theme-xl .q-hint { font-size: 41rpx; }
.theme-xl .option { font-size: 38rpx; }
.theme-xl .spell-input { font-size: 43rpx; }
.theme-xl .title { font-size: 49rpx; }
.theme-xl .subtitle { font-size: 35rpx; }
.theme-xl .muted { font-size: 32rpx; }

/* 儿童模式：整页放大，而不是只放大标题。
   以前儿童模式只把 5 类元素放大 12%，例句正文、按钮、选项、进度一个字都没变——
   而例句恰好是孩子最需要看清的地方。这里按三个练习页里承载正文的类逐个放大，
   由 utils/theme.js 在档案是儿童模式时把 .theme-kid 加到 root view 上。
   注意 .stage-word.sentence 必须单独写：它和 .stage-word 同优先级，页面样式在后会盖掉。 */
.theme-kid .word { font-size: 82rpx; }
.theme-kid .stage-word { font-size: 72rpx; }
.theme-kid .stage-word.sentence { font-size: 42rpx; }
.theme-kid .meaning { font-size: 44rpx; }
.theme-kid .stage-meaning { font-size: 34rpx; }
.theme-kid .phonetic,
.theme-kid .stage-phonetic { font-size: 34rpx; }
.theme-kid .example,
.theme-kid .example-en { font-size: 33rpx; }
.theme-kid .example-cn { font-size: 30rpx; }
.theme-kid .q-prompt { font-size: 42rpx; }
.theme-kid .q-hint { font-size: 34rpx; }
.theme-kid .option { font-size: 33rpx; }
.theme-kid .spell-input { font-size: 36rpx; }
.theme-kid .play-btn,
.theme-kid .speak-btn,
.theme-kid .play-example,
.theme-kid .play-mine { font-size: 32rpx; }
.theme-kid .rate-btn,
.theme-kid .rate-title,
.theme-kid .mode-tab,
.theme-kid .tool-btn,
.theme-kid .record-label,
.theme-kid .scene-picker { font-size: 30rpx; }
.theme-kid .progress-line,
.theme-kid .progress-text,
.theme-kid .muted,
.theme-kid .subtitle,
.theme-kid .setting-label,
.theme-kid .setting-value { font-size: 28rpx; }
.theme-kid .known-skip,
.theme-kid .known-undo { font-size: 28rpx; }

.theme-dark { background: #1A1F2B; color: #E8EAF0; }
.theme-dark .card,
.theme-dark .header,
.theme-dark .stage,
.theme-dark .example-box,
.theme-dark .score-box,
.theme-dark .badge-item,
.theme-dark .cal-cell { background: #262D3D; color: #E8EAF0; }
.theme-dark .muted,
.theme-dark .subtitle,
.theme-dark .example-cn,
.theme-dark .stage-phonetic { color: #9AA3B5; }
.theme-dark .stage-word,
.theme-dark .example-en,
.theme-dark .rec-label { color: #8FA8FF; }
.theme-dark .scene-picker,
.theme-dark .cat-picker,
.theme-dark .filter-picker,
.theme-dark .play-btn,
.theme-dark .tool-btn,
.theme-dark .focus-bar.returning,
.theme-dark .input,
.theme-dark .textarea { background: #333C50; color: #E8EAF0; }

/* 按压反馈（第十轮）：微信的 view 没有内置点击反馈，只有 button 有。
   全项目 129 个 bindtap、wxss 里只有 5 个 :active、hover-class 0 处，
   点卡片/图标完全静默，手指不知道点上没有。这里给一个通用类，高频入口挂上即可。 */
.tap-hover { opacity: .62; }

/* 空状态（第十轮）：队列为空时不能再是纯白页 */
.empty-box { text-align: center; padding: 64rpx 24rpx; }
.empty-emoji { font-size: 88rpx; line-height: 1.2; }
.empty-title { font-size: 34rpx; font-weight: 700; color: #1F2430; margin: 12rpx 0 10rpx; }
.empty-tip { font-size: 26rpx; color: #8A94A6; line-height: 1.7; margin-bottom: 28rpx; }
.empty-btn { margin-top: 16rpx; }
.theme-dark .empty-title { color: #E8EAF0; }
.theme-dark .empty-tip { color: #9AA3B5; }
