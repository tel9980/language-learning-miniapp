<view class="wrap">
  <view class="card">
    <view class="title">离线发音</view>
    <view class="desc">这些音频随小程序包发布，不走网络、不用密钥、断网也能听。</view>

    <view class="row">
      <text class="k">日语</text>
      <text class="v">{{jaCount}} 条 · {{jaKb}}KB</text>
      <text class="s {{ready?'ok':'wait'}}">{{ready?'已就绪':'加载中…'}}</text>
    </view>
    <view class="row">
      <text class="k">英语</text>
      <text class="v">{{enCount}} 条 · {{enKb}}KB</text>
      <text class="s ok">已就绪</text>
    </view>

    <button class="btn" size="mini" bindtap="load" loading="{{loading}}">{{ready?'重新检查':'加载日语包'}}</button>
  </view>

  <view class="card">
    <view class="title">试听</view>
    <view class="item" wx:for="{{samples}}" wx:key="id"
          data-id="{{item.id}}" data-text="{{item.text}}" bindtap="play" bindlongpress="stop">
      <text class="jp">{{item.text}}</text>
      <text class="cn">{{item.cn}}</text>
    </view>
    <view class="tip">点一下听，长按停止。</view>
  </view>
</view>
